# Copy this file to `.env` and replace placeholder values.
# Do not commit real secrets.

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGO_DB=portfolio_db
MONGO_COLLECTION=visitors

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>?secure=true

# hCaptcha
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
HCAPTCHA_ENABLED=true

# SMTP (for Admin OTP email)
# Use an SMTP app-password (e.g., Google “App Password” / Microsoft “App Password”)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-smtp-username@example.com
SMTP_FROM_NAME=JPA Server Community

# Choose one:
# SMTP_USE_TLS=true  (STARTTLS, common for port 587)
# SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Admin OTP settings
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_LENGTH=6

# Optional: shared cache / rate-limit counters (Redis)
# Set CACHE_TYPE=RedisCache only when CACHE_REDIS_URL is configured.
CACHE_TYPE=simple
# CACHE_REDIS_URL=rediss://default:<password>@<host>:<port>/0
CACHE_DEFAULT_TIMEOUT=86400
CACHE_KEY_PREFIX=jpa_profile:

# Optional: app-level DDoS / abuse guard
DDOS_GUARD_ENABLED=true
# MAX_CONTENT_LENGTH_BYTES=314572800
# DDOS_GUARD_GLOBAL_BURST_LIMIT=80
# DDOS_GUARD_GLOBAL_BURST_WINDOW=10
# DDOS_GUARD_GLOBAL_SUSTAINED_LIMIT=900
# DDOS_GUARD_GLOBAL_SUSTAINED_WINDOW=300
# DDOS_GUARD_MEDIA_BURST_LIMIT=12
# DDOS_GUARD_MEDIA_BURST_WINDOW=10
# DDOS_GUARD_MEDIA_SUSTAINED_LIMIT=120
# DDOS_GUARD_MEDIA_SUSTAINED_WINDOW=300
# DDOS_GUARD_ENGAGEMENT_BURST_LIMIT=10
# DDOS_GUARD_ENGAGEMENT_BURST_WINDOW=10
# DDOS_GUARD_ENGAGEMENT_SUSTAINED_LIMIT=120
# DDOS_GUARD_ENGAGEMENT_SUSTAINED_WINDOW=300
# DDOS_GUARD_ADMIN_LOGIN_LIMIT=8
# DDOS_GUARD_ADMIN_LOGIN_WINDOW=300
# DDOS_GUARD_DEVICE_INFO_LIMIT=30
# DDOS_GUARD_DEVICE_INFO_WINDOW=60

# Optional: admin login hardening (extra anti-bruteforce layer)
ADMIN_LOGIN_GUARD_ENABLED=true
# ADMIN_LOGIN_MIN_FORM_AGE_SECONDS=1
# ADMIN_LOGIN_MAX_FORM_AGE_SECONDS=1800
# ADMIN_LOGIN_FAIL_WINDOW_SECONDS=900
# ADMIN_LOGIN_MAX_FAILURES_PER_IP=8
# ADMIN_LOGIN_MAX_FAILURES_PER_USERNAME=10
# ADMIN_LOGIN_MAX_FAILURES_PER_IP_USERNAME=5
# ADMIN_LOGIN_COOLDOWN_BASE_SECONDS=2
# ADMIN_LOGIN_COOLDOWN_MAX_SECONDS=60
# ADMIN_LOGIN_LOCK_SECONDS_IP=1800
# ADMIN_LOGIN_LOCK_SECONDS_USERNAME=3600
# ADMIN_LOGIN_LOCK_SECONDS_IP_USERNAME=3600

# Optional: session cookie hardening (set secure=true in HTTPS deployments like Render)
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax

# Domains by purpose (bare hostnames, no scheme).
# Keep each one configurable separately so local and production can differ
# independently while the application and routing structure stay the same.
# Local defaults:
#   Professional landing: http://professional.jpastack.local
#   Social landing: http://jpastack.local or http://social.jpastack.local
#   Admin/config (incl. admin login): http://config.jpastack.local
# Production example:
#   LANDING_DOMAIN=jpastack.com
#   PROFESSIONAL_DOMAIN=professional.jpastack.com
#   SOCIAL_DOMAIN=social.jpastack.com
#   ADMIN_DOMAIN=config.jpastack.com
LANDING_DOMAIN=jpastack.local
PROFESSIONAL_DOMAIN=professional.jpastack.local
SOCIAL_DOMAIN=social.jpastack.local
ADMIN_DOMAIN=config.jpastack.local
# Set to false to disable purpose-based redirects (e.g. single-domain deploys).
# Unknown hosts (localhost, 127.0.0.1, Render domains, tests) always bypass.
DOMAIN_ROUTING_ENABLED=true
