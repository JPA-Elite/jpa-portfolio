{
  "name": "jpa-profile-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "python app/scripts/build_frontend.py --out dist/frontend --templates-only && node scripts/build-frontend.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev": "concurrently -k -n VITE,FLASK -c blue,green \"npm run dev:frontend\" \"cross-env VITE_DEV_SERVER=http://127.0.0.1:5173 python -m app.app\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "csso": "^5.0.5",
    "terser": "^5.48.0",
    "vite": "^5.4.5"
  }
}
